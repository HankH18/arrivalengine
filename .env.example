# Copy to .env and fill in. Every key here maps to a field on arrival.config.Settings.
# Nothing in this file is required to run the test suite — the suite is offline.

# Anthropic API key for the LLM client (T-2). Unset => LLM-backed paths are unavailable.
ANTHROPIC_API_KEY=

# Tavily search key (SPEC Q2 default). Unset => the search connector falls back to DDG-lite.
TAVILY_API_KEY=

# GitHub personal access token; unauthenticated calls work but are rate-limited hard.
GITHUB_TOKEN=

# Contact address advertised in the outbound User-Agent (SPEC C5).
CONTACT_EMAIL=arrival-engine@example.com

# Serve the operator-only /debug views (R15). 1/true enables; anything else 404s.
DEBUG_VIEWS=0

# Model ids are SETTINGS, not constants (DESIGN Decision 9).
# Cheap/fast model: extraction and taste classification.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Smart model: resolution verdicts and the say-out-loud line.
ANTHROPIC_MODEL_SMART=claude-sonnet-5

# Optional: where the HTTP disk cache lives (T-1). Defaults to .cache/http.
# CACHE_DIR=.cache/http
